# Скопируйте в `.env` и подставьте значения. Имена совпадают с плейсхолдерами в
# `src/main/resources/application.yml` (${VAR:default}); для вложенных
# `mdwiki.*` без плейсхолдера можно задать переменные вида MDWIKI_JWT_EXPIRATION_MS.
#
# Spring Boot сам файл `.env` не загружает. Для `./gradlew bootRun` переменные
# из `.env` подмешиваются в окружение через `build.gradle.kts`. Для `java -jar`,
# Docker и IDE задайте те же переменные вручную или через env_file / Run config.

# --- JWT (в проде — длинная случайная строка; короткий пароль допустим локально — ключ берётся как SHA-256 от строки) ---
JWT_SECRET=

# --- Пути ---
MDWIKI_CONTENT_DIR=./wiki-content
# Лимиты upload изображений
MDWIKI_UPLOAD_MAX_FILE_SIZE=20MB
MDWIKI_UPLOAD_MAX_REQUEST_SIZE=25MB

# Директории хоста, из которых MCP-инструменту wiki_attachment_upload разрешено
# читать файлы (через запятую). Если не задано — импорт по пути запрещён (защита от LFI).
# MDWIKI_ATTACHMENTS_ALLOWED_IMPORT_DIRS=/data/import,/tmp/uploads

# --- Эмбеддинги: openai | ollama | lmstudio ---
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1536

# OpenAI-совместимый API (OpenAI, прокси и т.п.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
LMSTUDIO_API_KEY=

# Опционально: путь к ONNX cross-encoder модели для rerank.
# Если не задан, используется fallback с uniform score.
# MDWIKI_RERANKER_MODEL_PATH=./models/cross-encoder.onnx

# --- Срок жизни JWT (мс); по умолчанию в application.yml задано 86400000 ---
# MDWIKI_JWT_EXPIRATION_MS=86400000

# --- БД (в application.yml заданы дефолты; переопределение через стандартные свойства Spring) ---
# Совпадает с docker-compose: порт 54328, БД mdwiki, пользователь mdwiki.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:54328/mdwiki
# SPRING_DATASOURCE_USERNAME=mdwiki
# SPRING_DATASOURCE_PASSWORD=mdwiki
